# API Environment — copy to apps/api/.env
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JWT_SECRET=change-me-to-a-64-char-random-secret-before-production
PORT=3001
NODE_ENV=development

# AI (leave blank for demo mode)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# University domain allow-list
ALLOWED_UNI_DOMAINS=ac.uk,edu,student.manchester.ac.uk,kcl.ac.uk,ucl.ac.uk,imperial.ac.uk

# QR verification
QR_TOKEN_EXPIRY_SECONDS=30
QR_PROXIMITY_THRESHOLD_METERS=15

# Demo flag — set false when all integrations are live
DEMO_MODE=true
